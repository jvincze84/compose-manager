# Másold .env-re és állítsd be! A docker.sock root-szintű hozzáférést ad a hosthoz.
AUTH_USER=admin
AUTH_PASSWORD=valami-hosszu-jelszo
# Host port (alapértelmezés: 8095)
PORT=8095
# Az alkalmazás neve (címsor, fejléc, PWA telepítéskor)
APP_NAME=Compose Manager
# Rövid név a kezdőképernyő ikonja alatt (üres = APP_NAME)
APP_SHORT_NAME=Compose
