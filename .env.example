# Copy to .env and edit! docker.sock gives root-level access to the host.
AUTH_USER=admin
AUTH_PASSWORD=some-long-password
# Host port (default: 8095)
PORT=8095
# App name (title, header, PWA install)
APP_NAME=Compose Manager
# Short name under the home-screen icon (empty = APP_NAME)
APP_SHORT_NAME=Compose
